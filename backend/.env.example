SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Must match Supabase Dashboard → Project Settings → API → JWT Secret (not anon key)
JWT_SECRET=your-jwt-secret
PORT=4000
NODE_ENV=development

# Google Calendar OAuth (from Google Auth Platform → Clients → StudySync)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
FRONTEND_URL=http://localhost:5173
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
